{
  "name": "luora-os",
  "version": "0.1.0",
  "private": true,
  "description": "Order and shipping hub for Shopify, Allegro and Empik on Cloudflare Workers, D1, Queues and R2",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && wrangler dev --test-scheduled",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply luora --local",
    "db:migrate:remote": "wrangler d1 migrations apply luora --remote",
    "db:seed:local": "tsx scripts/seed.ts",
    "integration:check": "tsx scripts/integration-check.ts",
    "i18n:check": "tsx scripts/check-i18n.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "^1.48.0",
    "motion": "^14.9.0",
    "next": "16.3.6",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "msw": "^2.15.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.138.0"
  }
}
